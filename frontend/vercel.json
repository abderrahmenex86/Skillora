{
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://replace-with-your-render-service.onrender.com/api/:path*"
        },
        {
            "source": "/share/:path*",
            "destination": "https://replace-with-your-render-service.onrender.com/share/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
