datasource db {
   provider = "postgresql"
   url      = env("DATABASE_URL")
}

generator client {
   provider = "prisma-client-js"
}

enum Role {
   APPLICANT
   RECRUITER
   ADMIN
}

enum SubscriptionTier {
   FREE
   PRO
   ENTERPRISE
}

enum PositionStatus {
   DRAFT
   OPEN
   CLOSED
}

enum ApplicationStatus {
   SUBMITTED
   EVALUATING
   ELIGIBLE
   NEEDS_REVIEW
   REDIRECTED
   INTERVIEW_PENDING
   INTERVIEW_SCHEDULED
   REJECTED
   CLOSED
}

enum InterviewStatus {
   RANGE_PENDING
   SLOT_CONFIRMED
   COMPLETED
   CANCELED
}

model User {
   id                    String           @id @default(uuid())
   email                 String           @unique
   passwordHash          String
   firstName             String
   middleName            String?
   lastName              String
   phone                 String?
   wilaya                String?
   role                  Role             @default(APPLICANT)
   subscriptionTier      SubscriptionTier @default(FREE)
   subscriptionExpiresAt DateTime?
   companyName           String?
   createdAt             DateTime         @default(now())
   updatedAt             DateTime         @updatedAt

   vaultEducations     VaultEducation[]
   vaultExperiences    VaultExperience[]
   vaultProjects       VaultProject[]
   vaultCertifications VaultCertification[]
   vaultVolunteering   VaultVolunteering[]
   vaultLanguages      VaultLanguage[]
   vaultLinks          VaultLink[]
   vaultEntries        VaultEntry[]

   profiles            ApplicantProfile[]
   applications        Application[]      @relation("CandidateApplications")
   positions           Position[]         @relation("RecruiterPositions")
   interviewEvents     InterviewEvent[]   @relation("CandidateInterviews")
   recruiterInterviews InterviewEvent[]   @relation("RecruiterInterviews")
   refreshTokens       RefreshToken[]

   @@map("users")
}

model VaultEducation {
   id          String   @id @default(uuid())
   userId      String
   degree      String
   institution String
   field       String
   startDate   String?
   endDate     String?
   createdAt   DateTime @default(now())

   user User @relation(fields: [userId], references: [id], onDelete: Cascade)

   @@index([userId])
   @@map("vault_educations")
}

model VaultExperience {
   id         String   @id @default(uuid())
   userId     String
   company    String
   role       String
   location   String?
   startDate  String
   endDate    String?
   highlights String[]
   createdAt  DateTime @default(now())

   user User @relation(fields: [userId], references: [id], onDelete: Cascade)

   @@index([userId])
   @@map("vault_experiences")
}

model VaultProject {
   id          String   @id @default(uuid())
   userId      String
   title       String
   projectUrl  String?
   description String?
   date        String?
   narratives  Json
   tags        String[]
   createdAt   DateTime @default(now())

   user User @relation(fields: [userId], references: [id], onDelete: Cascade)

   @@index([userId])
   @@map("vault_projects")
}

model VaultCertification {
   id           String   @id @default(uuid())
   userId       String
   name         String
   issuer       String
   issueDate    String?
   credentialId String?
   createdAt    DateTime @default(now())

   user User @relation(fields: [userId], references: [id], onDelete: Cascade)

   @@index([userId])
   @@map("vault_certifications")
}

model ApplicantProfile {
   id        String   @id @default(uuid())
   userId    String
   title     String
   resumeUrl String?
   summary   String?
   skills    String[]

   selectedEducationIds     String[]
   selectedExperienceIds    String[]
   selectedProjectIds       String[] @default([])
   selectedProjectAngles    Json?
   selectedCertificationIds String[]
   selectedLinkIds          String[] @default([])
   selectedVolunteeringIds  String[] @default([])
   selectedLanguageIds      String[] @default([])

   createdAt DateTime @default(now())
   updatedAt DateTime @updatedAt

   user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
   applications Application[]

   @@index([userId])
   @@map("applicant_profiles")
}

model VaultVolunteering {
   id           String   @id @default(uuid())
   userId       String
   organization String
   role         String
   description  String?
   startDate    String?
   endDate      String?
   createdAt    DateTime @default(now())

   user User @relation(fields: [userId], references: [id], onDelete: Cascade)

   @@index([userId])
   @@map("vault_volunteering")
}

model VaultLanguage {
   id          String   @id @default(uuid())
   userId      String
   name        String
   proficiency String
   createdAt   DateTime @default(now())

   user User @relation(fields: [userId], references: [id], onDelete: Cascade)

   @@index([userId])
   @@map("vault_languages")
}

model VaultLink {
   id        String   @id @default(uuid())
   userId    String
   label     String
   url       String
   type      String   @default("other")
   createdAt DateTime @default(now())

   user User @relation(fields: [userId], references: [id], onDelete: Cascade)

   @@index([userId])
   @@map("vault_links")
}

model VaultEntry {
   id          String   @id @default(uuid())
   userId      String
   section     String
   title       String
   subtitle    String?
   description String?
   date        String?
   endDate     String?
   url         String?
   tags        String[]
   createdAt   DateTime @default(now())

   user User @relation(fields: [userId], references: [id], onDelete: Cascade)

   @@index([userId, section])
   @@map("vault_entries")
}

model RefreshToken {
   id        String   @id @default(uuid())
   token     String   @unique
   userId    String
   expiresAt DateTime
   createdAt DateTime @default(now())

   user User @relation(fields: [userId], references: [id], onDelete: Cascade)

   @@index([userId])
   @@map("refresh_tokens")
}

model Position {
   id          String         @id @default(uuid())
   recruiterId String
   companyName String
   title       String
   department  String
   location    String
   deadline    DateTime
   status      PositionStatus @default(OPEN)
   rubric      Json
   createdAt   DateTime       @default(now())
   updatedAt   DateTime       @updatedAt

   recruiter    User            @relation("RecruiterPositions", fields: [recruiterId], references: [id], onDelete: Cascade)
   applications Application[]
   slots        RecruiterSlot[]

   @@index([status, deadline])
   @@map("positions")
}

model RecruiterSlot {
   id         String @id @default(uuid())
   positionId String
   dayOfWeek  Int
   startTime  String
   endTime    String

   position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

   @@index([positionId])
   @@map("recruiter_slots")
}

model Application {
   id                String            @id @default(uuid())
   positionId        String
   applicantId       String
   profileId         String
   anonymousId       String
   status            ApplicationStatus @default(SUBMITTED)
   matchScore        Int?
   rubricAudit       Json?
   gapAnalysis       Json?
   recruiterOverride Boolean           @default(false)
   overrideNotes     String?
   appliedAt         DateTime          @default(now())
   updatedAt         DateTime          @updatedAt

   position       Position            @relation(fields: [positionId], references: [id], onDelete: Cascade)
   applicant      User                @relation("CandidateApplications", fields: [applicantId], references: [id], onDelete: Cascade)
   profile        ApplicantProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
   interviewEvent InterviewEvent?
   agentLogs      AgentExecutionLog[]

   @@unique([positionId, applicantId])
   @@index([positionId, status])
   @@index([applicantId])
   @@map("applications")
}

model InterviewEvent {
   id             String          @id @default(uuid())
   applicationId  String          @unique
   applicantId    String
   recruiterId    String
   status         InterviewStatus @default(RANGE_PENDING)
   proposedRanges Json?
   confirmedStart DateTime?
   confirmedEnd   DateTime?
   meetingLink    String?
   unmaskedAt     DateTime?
   createdAt      DateTime        @default(now())
   updatedAt      DateTime        @updatedAt

   application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
   applicant   User        @relation("CandidateInterviews", fields: [applicantId], references: [id], onDelete: Cascade)
   recruiter   User        @relation("RecruiterInterviews", fields: [recruiterId], references: [id], onDelete: Cascade)

   @@index([applicantId])
   @@index([recruiterId])
   @@map("interview_events")
}

model AgentExecutionLog {
   id               String   @id @default(uuid())
   applicationId    String
   agentType        String
   modelUsed        String
   promptTokens     Int
   outputTokens     Int
   rawInput         Json
   structuredOutput Json
   createdAt        DateTime @default(now())

   application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

   @@index([applicationId, agentType])
   @@map("agent_execution_logs")
}
