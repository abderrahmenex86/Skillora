PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Optional: public origin that serves /share (defaults to CLIENT_URL).
# Set this to the backend origin if /share is not proxied on the app origin.
# PUBLIC_SHARE_ORIGIN=https://api.example.com

# PostgreSQL connection strings.
# Neon: DATABASE_URL is the pooled (-pooler) URL used by the app, and
# DATABASE_URL_UNPOOLED is the direct URL Prisma uses for schema changes.
# For a local database, point both at the same server.
DATABASE_URL=postgresql://skillora_user:skillora_pass@localhost:5432/skillora_db?schema=public
DATABASE_URL_UNPOOLED=postgresql://skillora_user:skillora_pass@localhost:5432/skillora_db?schema=public

# Dual-Token Secrets
JWT_ACCESS_SECRET=your_super_secret_access_key_min_32_chars_123456
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars_654321

# Multi-provider LLM adapter
# Choose "groq" for the hosted Groq API or "ollama" for a local Ollama server.
LLM_PROVIDER=groq
# Groq: use a model available to your account (for example openai/gpt-oss-120b).
# Ollama: use a local model such as llama3.1:8b.
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=your_groq_api_key

# Local Ollama (OpenAI-compatible endpoint)
OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=ollama

# Generation settings
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=2
