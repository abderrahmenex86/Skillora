{
    "name": "skillora-backend",
    "version": "1.0.0",
    "private": true,
    "main": "dist/server.js",
    "scripts": {
        "build": "tsc",
        "start": "node dist/server.js",
        "dev": "tsx watch src/server.ts",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:seed": "tsx prisma/seed.ts",
        "e2e:seed": "tsx scripts/e2e-test-data.ts",
        "e2e:test": "tsx scripts/e2e-test-data.ts --verify",
        "db:clean": "tsx scripts/clean-database.ts",
        "db:clean:yes": "tsx scripts/clean-database.ts --yes",
        "db:clean:dry": "tsx scripts/clean-database.ts --dry-run",
        "applications:reevaluate": "tsx scripts/reevaluate-pending.ts",
        "applications:reevaluate:dry": "tsx scripts/reevaluate-pending.ts --dry-run"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    },
    "dependencies": {
        "@ai-sdk/groq": "^4.0.72",
        "@ai-sdk/openai": "^4.0.104",
        "@prisma/client": "^6.4.1",
        "ai": "^7.0.155",
        "bcryptjs": "^3.0.2",
        "bullmq": "^5.41.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "helmet": "^8.0.0",
        "ioredis": "^5.6.0",
        "jsonwebtoken": "^9.0.2",
        "zod": "^3.24.2"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cookie-parser": "^1.4.8",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/ioredis": "^5.0.0",
        "@types/jsonwebtoken": "^9.0.9",
        "@types/node": "^22.13.8",
        "prisma": "^6.4.1",
        "tsx": "^4.19.3",
        "typescript": "^5.7.3"
    }
}
