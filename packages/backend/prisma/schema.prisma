datasource db {
   provider = "postgresql"
   url      = env("DATABASE_URL")
}

generator client {
   provider = "prisma-client-js"
}

enum Role {
   APPLICANT
   RECRUITER
   ADMIN
}

enum SubscriptionTier {
   FREE
   PRO
   ENTERPRISE
}

enum PositionStatus {
   DRAFT
   OPEN
   CLOSED
}

enum ApplicationStatus {
   SUBMITTED
   EVALUATING
   ELIGIBLE
   NEEDS_REVIEW
   REDIRECTED
   INTERVIEW_PENDING
   INTERVIEW_SCHEDULED
   REJECTED
   CLOSED
}

enum InterviewStatus {
   RANGE_PENDING
   SLOT_CONFIRMED
   COMPLETED
   CANCELED
}

model User {
   id                    String           @id @default(uuid())
   email                 String           @unique
   passwordHash          String
   role                  Role             @default(APPLICANT)
   subscriptionTier      SubscriptionTier @default(FREE)
   subscriptionExpiresAt DateTime?
   createdAt             DateTime         @default(now())
   updatedAt             DateTime         @updatedAt

   profiles            ApplicantProfile[]
   applications        Application[]      @relation("CandidateApplications")
   positions           Position[]         @relation("RecruiterPositions")
   interviewEvents     InterviewEvent[]   @relation("CandidateInterviews")
   recruiterInterviews InterviewEvent[]   @relation("RecruiterInterviews")
   refreshTokens       RefreshToken[]

   @@map("users")
}

model RefreshToken {
   id        String   @id @default(uuid())
   token     String   @unique
   userId    String
   expiresAt DateTime
   createdAt DateTime @default(now())

   user User @relation(fields: [userId], references: [id], onDelete: Cascade)

   @@index([userId])
   @@map("refresh_tokens")
}

model ApplicantProfile {
   id        String   @id @default(uuid())
   userId    String
   title     String
   resumeUrl String
   summary   String?
   skills    String[]
   metadata  Json?
   createdAt DateTime @default(now())
   updatedAt DateTime @updatedAt

   user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
   applications Application[]

   @@index([userId])
   @@map("applicant_profiles")
}

model Position {
   id          String         @id @default(uuid())
   recruiterId String
   companyName String
   title       String
   department  String
   location    String
   deadline    DateTime
   status      PositionStatus @default(OPEN)
   rubric      Json
   createdAt   DateTime       @default(now())
   updatedAt   DateTime       @updatedAt

   recruiter    User            @relation("RecruiterPositions", fields: [recruiterId], references: [id], onDelete: Cascade)
   applications Application[]
   slots        RecruiterSlot[]

   @@index([status, deadline])
   @@map("positions")
}

model RecruiterSlot {
   id         String @id @default(uuid())
   positionId String
   dayOfWeek  Int
   startTime  String
   endTime    String

   position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

   @@index([positionId])
   @@map("recruiter_slots")
}

model Application {
   id                String            @id @default(uuid())
   positionId        String
   applicantId       String
   profileId         String
   anonymousId       String
   status            ApplicationStatus @default(SUBMITTED)
   matchScore        Int?
   rubricAudit       Json?
   gapAnalysis       Json?
   recruiterOverride Boolean           @default(false)
   overrideNotes     String?
   appliedAt         DateTime          @default(now())
   updatedAt         DateTime          @updatedAt

   position       Position            @relation(fields: [positionId], references: [id], onDelete: Cascade)
   applicant      User                @relation("CandidateApplications", fields: [applicantId], references: [id], onDelete: Cascade)
   profile        ApplicantProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
   interviewEvent InterviewEvent?
   agentLogs      AgentExecutionLog[]

   @@unique([positionId, applicantId])
   @@index([positionId, status])
   @@index([applicantId])
   @@map("applications")
}

model InterviewEvent {
   id             String          @id @default(uuid())
   applicationId  String          @unique
   applicantId    String
   recruiterId    String
   status         InterviewStatus @default(RANGE_PENDING)
   proposedRanges Json?
   confirmedStart DateTime?
   confirmedEnd   DateTime?
   meetingLink    String?
   unmaskedAt     DateTime?
   createdAt      DateTime        @default(now())
   updatedAt      DateTime        @updatedAt

   application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
   applicant   User        @relation("CandidateInterviews", fields: [applicantId], references: [id], onDelete: Cascade)
   recruiter   User        @relation("RecruiterInterviews", fields: [recruiterId], references: [id], onDelete: Cascade)

   @@index([applicantId])
   @@index([recruiterId])
   @@map("interview_events")
}

model AgentExecutionLog {
   id               String   @id @default(uuid())
   applicationId    String
   agentType        String
   modelUsed        String
   promptTokens     Int
   outputTokens     Int
   rawInput         Json
   structuredOutput Json
   createdAt        DateTime @default(now())

   application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

   @@index([applicationId, agentType])
   @@map("agent_execution_logs")
}
